{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "content-window",
  "description": "The container page may drag the window from the top strip.",
  "webviews": ["main"],
  "local": false,
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*",
      "https://127.0.0.1:*",
      "https://localhost:*"
    ]
  },
  "permissions": ["core:window:allow-start-dragging"]
}
