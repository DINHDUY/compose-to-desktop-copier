{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{ product_name }}",
  "version": "0.1.0",
  "identifier": "{{ bundle_identifier }}",
  "build": {
    "devUrl": "http://127.0.0.1:{{ ui_port }}",
    "frontendDist": "http://127.0.0.1:{{ ui_port }}"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      {# Null on purpose: the content window loads the product UI, which brings its own policy. #}
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../shell.toml": "shell.toml",
      "../docker-compose.yml": "docker-compose.yml",
      "../.env.example": ".env.example",
      "../installer/cache/docker-compose.exe": "docker-compose.exe",
      "../installer/cache/podman-installer.msi": "podman-installer.msi",
      "../installer/cache/LICENSE-podman": "LICENSE-podman",
      "../installer/cache/LICENSE-compose": "LICENSE-compose"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
